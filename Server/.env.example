# Server
NODE_ENV=development
PORT=5000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=emergency_user
DB_PASSWORD=securepassword
DB_NAME=emergency_wallet
DATABASE_URL=postgresql://emergency_user:securepassword@postgres:5432/emergency_wallet

# Supabase Configuration (for frontend compatibility)
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-key
SUPABASE_JWT_SECRET=super-secret-jwt-key-change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=super-secret-jwt-key-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# M-Pesa (Daraja) - Sandbox Credentials
MPESA_CONSUMER_KEY=your_sandbox_consumer_key
MPESA_CONSUMER_SECRET=your_sandbox_consumer_secret
MPESA_PASSKEY=your_sandbox_passkey
MPESA_SHORTCODE=174379
MPESA_ENV=sandbox
MPESA_DEMO_MODE=true

# M-Pesa Callback Configuration
CALLBACK_BASE_URL=https://your-domain.com
MPESA_INITIATOR_NAME=testapi
MPESA_SECURITY_CREDENTIAL=your_encrypted_security_credential

# Production M-Pesa Credentials (uncomment for production)
# MPESA_CONSUMER_KEY=your_production_consumer_key
# MPESA_CONSUMER_SECRET=your_production_consumer_secret
# MPESA_PASSKEY=your_production_passkey
# MPESA_SHORTCODE=your_production_shortcode
# MPESA_ENV=production

# Transaction Limits
DAILY_LIMIT=5000
MONTHLY_LIMIT=50000
MAX_TRANSACTION_AMOUNT=5000

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log